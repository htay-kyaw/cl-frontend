# Laravel API base URL — used only on the Next.js server (not exposed to the browser)
API_URL=http://localhost:8000/api

# OAuth 2.0 Web client ID from Google Cloud Console (same value as backend GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Client secret of that same OAuth client (server-side only, never NEXT_PUBLIC_).
# The client's "Authorized redirect URIs" must list <site>/auth/google/callback for every
# site, e.g. http://localhost:3000/auth/google/callback and https://<vercel-domain>/auth/google/callback
GOOGLE_CLIENT_SECRET=

# Production only: same value as the backend's WEB_PROXY_SECRET (server-side, never NEXT_PUBLIC_)
API_PROXY_SECRET=
